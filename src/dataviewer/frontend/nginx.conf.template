server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Proxy API requests to the backend service.
    # NGINX_BACKEND_HOST defaults to "backend:8000" (docker-compose service name).
    # Override at runtime via NGINX_BACKEND_HOST environment variable.
    location /api/ {
        proxy_pass http://${NGINX_BACKEND_HOST};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Support large video file streaming
        proxy_buffering off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        client_max_body_size 0;
    }

    # Health endpoint proxied from backend
    location /health {
        proxy_pass http://${NGINX_BACKEND_HOST}/health;
    }

    # SPA fallback: all other routes served by index.html
    location / {
        try_files $uri $uri/ /index.html;
    }
}
